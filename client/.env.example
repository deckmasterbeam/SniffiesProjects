# Base URL of the deployed server (no trailing slash).
SERVER_BASE=https://sniffies-projects.vercel.app

# Bearer token for client-facing API endpoints. Baked into the extension
# bundle, so it isn't truly secret — it just prevents casual scraping.
CLIENT_SECRET=ed6fd0cd-fe58-4dcc-83cd-65651771e0e9

# Set to true to enable debug overlays on sniffies.com.
DEBUG=false

# Set to exactly "true" to enable the favorites/notification features (requires server
# support); anything else (including unset) is off. CI reads this from the repo's Actions
# variables for prod builds, not this file.
FAVORITES_NOTIFICATIONS_ENABLED=false

# Set to exactly "true" to enable bot reporting (report button + blocked-bots fetch;
# requires server support); anything else (including unset) is off. CI reads this from the
# repo's Actions variables for prod builds, not this file.
REPORTING_ENABLED=false
