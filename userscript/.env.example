# Base URL of the deployed server (no trailing slash).
SERVER_BASE=https://sniffies-projects.vercel.app

# Bearer token for client-facing API endpoints. Baked into the userscript
# bundle, so it isn't truly secret — it just prevents casual scraping.
CLIENT_SECRET=ed6fd0cd-fe58-4dcc-83cd-65651771e0e9

# Set to true to enable debug logging.
DEBUG=

# Set to exactly "true" to enable bot reporting/blocking; anything else (including unset)
# is off. CI reads this from the repo's Actions variables for prod builds, not this file.
REPORTING_ENABLED=
