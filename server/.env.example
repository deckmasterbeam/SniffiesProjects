# Bearer token the public-facing client extension must send in the
# Authorization header. Baked into the client build at build time — not truly
# private, just enough to deter casual scraping. Generate a long random string.
#
# In the Vercel dashboard, set a DIFFERENT value for this for the Preview
# environment than Production. That's what lets you safely turn off Vercel
# Authentication (SSO protection) on preview deployments — requireClientAuth
# still 401s anyone who doesn't have the preview-specific secret. Build the
# extension with client/.env's CLIENT_SECRET set to match whichever
# deployment (prod or a given preview) you're testing against.
CLIENT_SECRET=ed6fd0cd-fe58-4dcc-83cd-65651771e0e9

# Bearer token the sideloaded watcher extension must send in the Authorization
# header. Never distributed publicly — keep this one actually secret, since it
# authorises sending SMS to all subscribers. Generate a long random string.
WATCHER_SECRET=

# TextBelt API key. Buy credits at https://textbelt.com.
# Use "textbelt" (no quotes) for the one free text per day during testing.
TEXTBELT_KEY=

# Max SMS per phone number per 24 hours. Priority numbers bypass this.
DAILY_SMS_LIMIT=10

# Neon/Vercel Postgres connection string. Added automatically when you link a
# Vercel Postgres (Neon) database to this project in the Vercel dashboard.
POSTGRES_URL=

# Optional comma-separated list of allowed Origin headers for CORS preflight.
# Chrome extensions send Origin: chrome-extension://<id>. Add yours here once
# the extension is loaded so you can lock the API down to just it.
# Leave blank to accept any origin (fine while developing).
ALLOWED_ORIGINS=

# Each of these must be exactly "true" to turn on its corresponding endpoint.
# Leave unset (or anything else) to keep that endpoint responding 404, hidden
# until it's ready to launch.
SAVE_NUMBER_ENABLED=
SEND_GUID_ENABLED=
FAVORITES_ENABLED=
NOTIFY_TEST_ENABLED=
